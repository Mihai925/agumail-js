{
  "name": "agumail-js",
  "version": "0.1.0",
  "description": "Add your users to AguMail and record what they do, so your AguMail flows can start from it.",
  "license": "MIT",
  "author": "AguMail",
  "homepage": "https://agumail.com",
  "keywords": [
    "agumail",
    "email",
    "email-marketing",
    "newsletter",
    "events",
    "automation"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:live": "vitest run test/live.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
